{
  "name": "summing",
  "version": "9.9.2",
  "description": "Persistent Telegram agent backed by the official Codex App Server",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/require-node-version.mjs",
    "build": "tsc -p tsconfig.json",
    "prestart": "node scripts/require-node-version.mjs",
    "start": "node dist/src/index.js",
    "prelint": "node scripts/require-node-version.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "node scripts/require-node-version.mjs",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "precodex:types": "node scripts/require-node-version.mjs",
    "codex:types": "codex app-server generate-ts --experimental --out .codex-protocol"
  },
  "dependencies": {
    "heic-convert": "^2.1.0",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
