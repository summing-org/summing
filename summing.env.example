SUMMING_DATA_DIR=/var/lib/summing/data
SUMMING_CONFIG=/var/lib/summing/data/config.toml
SUMMING_WORKTREE_ROOT=/var/lib/summing/data/worktrees
CODEX_HOME=/var/lib/summing/data/codex
CODEX_BIN=/usr/local/bin/codex
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
SUMMING_VIEWER_URL=
SUMMING_VIEWER_LOCAL_TOKEN=
SUMMING_RUNNER_SOCKET=/run/summing-runner/runner.sock
SUMMING_DEPLOY_REQUEST=/var/lib/summing/deploy/request.json
SUMMING_DEPLOY_STATE=/var/lib/summing/deploy/state.json
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_API_KEY=
GROQ_API_KEY=
SUMMING_OBJECT_STORE=s3
SUMMING_TELEGRAM_TERMS_REVIEWED=false
SUMMING_S3_ENDPOINT=
SUMMING_S3_REGION=us-east-1
SUMMING_S3_BUCKET=
SUMMING_S3_PREFIX=summing
SUMMING_S3_ACCESS_KEY_ID=
SUMMING_S3_SECRET_ACCESS_KEY=
SUMMING_S3_FORCE_PATH_STYLE=false
SUMMING_S3_SSE=AES256
SUMMING_S3_KMS_KEY_ID=
SUMMING_MTPROTO_KEY=/etc/summing/mtproto.key
SUMMING_DOCUMENT_VISION_MODEL=gpt-5.4-nano
NODE_ENV=production
