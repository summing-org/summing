[Unit]
Description=Fetch, verify, and atomically deploy Summate origin/master
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/summate/.git

[Service]
Type=oneshot
EnvironmentFile=-/etc/summate/deploy.env
ExecStart=/opt/summate-current/deploy/summate-deploy
TimeoutStartSec=45min
UMask=0027
PrivateTmp=true
ProtectHome=true
