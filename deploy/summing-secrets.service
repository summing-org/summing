[Unit]
Description=SUMMING encrypted connection and capability broker
After=network-online.target
Wants=network-online.target
Before=summing-runner.service summing.service

[Service]
Type=simple
User=summing-secrets
Group=summing-secrets
SupplementaryGroups=summing summing-runner
RuntimeDirectory=summing-secrets
RuntimeDirectoryMode=0755
StateDirectory=summing-secrets
StateDirectoryMode=0700
Environment=HOME=/var/lib/summing-secrets
EnvironmentFile=/etc/summing-secrets/summing-secrets.env
ExecStart=/usr/local/bin/node --enable-source-maps /opt/summing-current/dist/src/secret-broker-main.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/summing-secrets /run/summing-secrets
ReadOnlyPaths=/etc/summing-secrets
InaccessiblePaths=/etc/summing /etc/summing-runner

[Install]
WantedBy=multi-user.target
