#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: deploy/install-fresh --target root@HOST --secrets FILE [options]

Streams the current clean Git commit as a verified bundle and runs the
root-only secure bootstrap on a provisioned Ubuntu 24.04 host.

Options:
  --origin URL       Future self-update origin (defaults to local origin)
  --source-key FILE  SSH deploy key for that origin
  --identity FILE    SSH identity used to reach the target host
  --port PORT        SSH port (default: 22)
  --provision        Prepare a clean rebuilt Ubuntu host before installation
  --yes              Skip the final target/commit confirmation
EOF
}

target=
secrets=
origin=
source_key=
identity=
ssh_port=22
provision=0
assume_yes=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --target) target=${2:-}; shift 2 ;;
    --secrets) secrets=${2:-}; shift 2 ;;
    --origin) origin=${2:-}; shift 2 ;;
    --source-key) source_key=${2:-}; shift 2 ;;
    --identity) identity=${2:-}; shift 2 ;;
    --port) ssh_port=${2:-}; shift 2 ;;
    --provision) provision=1; shift ;;
    --yes) assume_yes=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -z "${target}" ] || [ -z "${secrets}" ]; then
  usage >&2
  exit 2
fi
case "${target}" in
  *[!A-Za-z0-9@._:-]*|'') printf '%s\n' 'Invalid SSH target.' >&2; exit 2 ;;
esac
case "${ssh_port}" in
  ''|*[!0-9]*) printf '%s\n' 'SSH port must be an integer.' >&2; exit 2 ;;
esac
if [ "${ssh_port}" -lt 1 ] || [ "${ssh_port}" -gt 65535 ]; then
  printf '%s\n' 'SSH port must be between 1 and 65535.' >&2
  exit 2
fi

absolute_input_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$(pwd -P)" "$1" ;;
  esac
}
secrets=$(absolute_input_path "${secrets}")
if [ -n "${source_key}" ]; then source_key=$(absolute_input_path "${source_key}"); fi
if [ -n "${identity}" ]; then identity=$(absolute_input_path "${identity}"); fi

repo_root=$(git rev-parse --show-toplevel)
if [ "$(pwd -P)" != "$(cd "${repo_root}" && pwd -P)" ]; then
  cd "${repo_root}"
fi
if ! git diff --quiet || ! git diff --cached --quiet; then
  printf '%s\n' 'Refusing to install from a checkout with tracked changes.' >&2
  exit 2
fi
commit=$(git rev-parse HEAD)
if ! printf '%s' "${commit}" | grep -Eq '^[0-9a-f]{40}$'; then
  printf '%s\n' 'Could not resolve a full release commit.' >&2
  exit 2
fi
if [ -z "${origin}" ]; then
  origin=$(git remote get-url origin)
fi
case "${origin}" in
  *[!A-Za-z0-9@:/._~-]*|''|http://*|https://*@*)
    printf '%s\n' 'Origin must use SSH or credential-free HTTPS and contain no shell metacharacters.' >&2
    exit 2
    ;;
esac
case "${origin}" in
  ssh://*|*@*:*)
    if [ -z "${source_key}" ]; then
      printf '%s\n' '--source-key is required for an SSH self-update origin.' >&2
      exit 2
    fi
    ;;
esac

private_mode() {
  local path=$1 mode
  if [ -L "${path}" ] || [ ! -f "${path}" ]; then
    printf 'Private input is not a regular file: %s\n' "${path}" >&2
    exit 2
  fi
  if stat -f '%Lp' "${path}" >/dev/null 2>&1; then
    mode=$(stat -f '%Lp' "${path}")
  else
    mode=$(stat -c '%a' "${path}")
  fi
  case "${mode}" in 400|600) ;; *) printf 'Private input must have mode 0400 or 0600: %s\n' "${path}" >&2; exit 2 ;; esac
}
private_mode "${secrets}"
if [ -n "${source_key}" ]; then private_mode "${source_key}"; fi
if [ -n "${identity}" ]; then private_mode "${identity}"; fi

ssh_args=(
  -p "${ssh_port}"
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
)
scp_args=(
  -P "${ssh_port}"
  -o BatchMode=yes
  -o ConnectTimeout=10
  -o StrictHostKeyChecking=accept-new
)
if [ -n "${identity}" ]; then
  ssh_args+=(-i "${identity}")
  scp_args+=(-i "${identity}")
fi

wait_for_ssh() {
  local attempt
  for attempt in $(seq 1 90); do
    if ssh "${ssh_args[@]}" "${target}" true >/dev/null 2>&1; then return 0; fi
    sleep 2
  done
  printf 'SSH did not become ready on %s:%s.\n' "${target}" "${ssh_port}" >&2
  return 1
}

reboot_and_wait() {
  local attempt offline=0
  if ssh "${ssh_args[@]}" "${target}" systemctl reboot >/dev/null 2>&1; then :; fi
  for attempt in $(seq 1 30); do
    if ! ssh "${ssh_args[@]}" "${target}" true >/dev/null 2>&1; then
      offline=1
      break
    fi
    sleep 1
  done
  if [ "${offline}" -ne 1 ]; then
    printf '%s\n' 'Target did not disconnect for the required reboot.' >&2
    return 1
  fi
  wait_for_ssh
}

if ! command -v node >/dev/null 2>&1 || [ "$(node -p 'Number(process.versions.node.split(".")[0])')" -lt 24 ]; then
  printf '%s\n' 'The operator machine requires Node.js 24 or newer.' >&2
  exit 2
fi
temporary=$(mktemp -d)
chmod 0700 "${temporary}"
remote_dir=
provision_dir=
cleanup_install_inputs() {
  local exit_status=$?
  if [ -n "${provision_dir}" ]; then
    ssh "${ssh_args[@]}" "${target}" rm -f -- \
      "${provision_dir}/provision-host" >/dev/null 2>&1 || true
    ssh "${ssh_args[@]}" "${target}" rmdir \
      "${provision_dir}" >/dev/null 2>&1 || true
  fi
  if [ -n "${remote_dir}" ]; then
    ssh "${ssh_args[@]}" "${target}" rm -f -- \
      "${remote_dir}/release.bundle" \
      "${remote_dir}/secrets.json" \
      "${remote_dir}/source-key" \
      "${remote_dir}/secure-bootstrap" >/dev/null 2>&1 || true
    ssh "${ssh_args[@]}" "${target}" rmdir \
      "${remote_dir}" >/dev/null 2>&1 || true
  fi
  rm -rf "${temporary}"
  trap - EXIT
  exit "${exit_status}"
}
trap cleanup_install_inputs EXIT
node "${repo_root}/scripts/render-fresh-install.mjs" \
  --input "${secrets}" \
  --env-output "${temporary}/validated.env" \
  --config-output "${temporary}/validated.toml" \
  --caddy-output "${temporary}/validated.Caddyfile" \
  >/dev/null

if [ "${assume_yes}" -ne 1 ]; then
  printf 'Install SUMMING commit %s on %s? [y/N] ' "${commit}" "${target}"
  read -r answer
  case "${answer}" in y|Y|yes|YES) ;; *) printf '%s\n' 'Cancelled.'; exit 1 ;; esac
fi

bundle=${temporary}/release.bundle
git bundle create "${bundle}" HEAD
git bundle verify "${bundle}" >/dev/null

remote_dir=/run/summing-fresh-${commit}
ssh "${ssh_args[@]}" "${target}" cloud-init status --wait
if [ "${provision}" -eq 1 ]; then
  provision_dir=/run/summing-provision-${commit}
  ssh "${ssh_args[@]}" "${target}" install -d -o root -g root -m 0700 "${provision_dir}"
  scp -q "${scp_args[@]}" "${repo_root}/deploy/provision-host" \
    "${target}:${provision_dir}/provision-host"
  ssh "${ssh_args[@]}" "${target}" chmod 0700 "${provision_dir}/provision-host"
  ssh "${ssh_args[@]}" "${target}" bash "${provision_dir}/provision-host" \
    --ssh-port "${ssh_port}"
  reboot_required=0
  if ssh "${ssh_args[@]}" "${target}" test -f /var/run/reboot-required; then
    reboot_required=1
  fi
  ssh "${ssh_args[@]}" "${target}" rm -f -- "${provision_dir}/provision-host"
  ssh "${ssh_args[@]}" "${target}" rmdir "${provision_dir}"
  if [ "${reboot_required}" -eq 1 ]; then reboot_and_wait; fi
fi
ssh "${ssh_args[@]}" "${target}" install -d -o root -g root -m 0700 "${remote_dir}"
scp -q "${scp_args[@]}" "${bundle}" "${repo_root}/deploy/secure-bootstrap" \
  "${target}:${remote_dir}/"
scp -q "${scp_args[@]}" "${secrets}" "${target}:${remote_dir}/secrets.json"
ssh "${ssh_args[@]}" "${target}" chmod 0600 \
  "${remote_dir}/release.bundle" "${remote_dir}/secrets.json"
ssh "${ssh_args[@]}" "${target}" chmod 0700 "${remote_dir}/secure-bootstrap"

remote_args=(
  bash
  "${remote_dir}/secure-bootstrap"
  --bundle "${remote_dir}/release.bundle"
  --secrets "${remote_dir}/secrets.json"
  --origin "${origin}"
  --expected-commit "${commit}"
  --consume-inputs
)
if [ -n "${source_key}" ]; then
  scp -q "${scp_args[@]}" "${source_key}" "${target}:${remote_dir}/source-key"
  ssh "${ssh_args[@]}" "${target}" chmod 0600 "${remote_dir}/source-key"
  remote_args+=(--source-key "${remote_dir}/source-key")
fi
printf -v remote_command '%q ' "${remote_args[@]}"
ssh "${ssh_args[@]}" "${target}" "${remote_command}"
ssh "${ssh_args[@]}" "${target}" rm -f -- "${remote_dir}/secure-bootstrap"
ssh "${ssh_args[@]}" "${target}" rmdir "${remote_dir}"

printf 'Fresh installation completed on %s at %s.\n' "${target}" "${commit}"
