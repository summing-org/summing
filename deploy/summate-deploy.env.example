# The deployment worker never sources /etc/summate/summate.env, so application
# credentials are not exposed to npm lifecycle or test processes.
SUMMATE_DEPLOY_REMOTE=origin
SUMMATE_DEPLOY_BRANCH=master
SUMMATE_DEPLOY_EXPECTED_REMOTE=git@summing.github.com:summing-org/summate.git
SUMMATE_DEPLOY_KEEP_RELEASES=5
SUMMATE_DEPLOY_DRAIN_TIMEOUT_SEC=1800
