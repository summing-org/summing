# The deployment worker never sources /etc/summing/summing.env, so application
# credentials are not exposed to npm lifecycle or test processes.
SUMMING_DEPLOY_REMOTE=origin
SUMMING_DEPLOY_BRANCH=master
SUMMING_DEPLOY_EXPECTED_REMOTE=git@summing.github.com:summing-org/summing.git
SUMMING_DEPLOY_KEEP_RELEASES=5
SUMMING_DEPLOY_DRAIN_TIMEOUT_SEC=1800
