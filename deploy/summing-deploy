#!/usr/bin/env bash
set -Eeuo pipefail

umask 0027

if [ "${EUID}" -ne 0 ]; then
  printf '%s\n' 'summing-deploy must run as root.' >&2
  exit 2
fi

repo_dir=${SUMMING_DEPLOY_REPO:-/opt/summing}
releases_dir=${SUMMING_DEPLOY_RELEASES:-/opt/summing-releases}
current_link=${SUMMING_DEPLOY_CURRENT:-/opt/summing-current}
state_dir=${SUMMING_DEPLOY_STATE_DIR:-/var/lib/summing/deploy}
state_file=${SUMMING_DEPLOY_STATE_FILE:-${state_dir}/state.json}
history_file=${SUMMING_DEPLOY_HISTORY_FILE:-${state_dir}/history.json}
event_dir=${SUMMING_DEPLOY_EVENT_DIR:-${state_dir}/events}
remote=${SUMMING_DEPLOY_REMOTE:-origin}
branch=${SUMMING_DEPLOY_BRANCH:-master}
expected_remote=${SUMMING_DEPLOY_EXPECTED_REMOTE:-git@summing.github.com:summing-org/summing.git}
keep_releases=${SUMMING_DEPLOY_KEEP_RELEASES:-5}
drain_timeout=${SUMMING_DEPLOY_DRAIN_TIMEOUT_SEC:-1800}
lock_file=${SUMMING_DEPLOY_LOCK_FILE:-/run/lock/summing-deploy.lock}
history_limit=20
deploy_report="$(dirname "${BASH_SOURCE[0]}")/summing-deploy-report"

case "${remote}" in
  ''|*[!A-Za-z0-9._-]*)
    printf '%s\n' 'SUMMING_DEPLOY_REMOTE is invalid.' >&2
    exit 2
    ;;
esac
case "${branch}" in
  ''|*[!A-Za-z0-9._/-]*|*..*|/*|*/)
    printf '%s\n' 'SUMMING_DEPLOY_BRANCH is invalid.' >&2
    exit 2
    ;;
esac
case "${keep_releases}" in
  ''|*[!0-9]*)
    printf '%s\n' 'SUMMING_DEPLOY_KEEP_RELEASES must be an integer.' >&2
    exit 2
    ;;
esac
case "${drain_timeout}" in
  ''|*[!0-9]*)
    printf '%s\n' 'SUMMING_DEPLOY_DRAIN_TIMEOUT_SEC must be an integer.' >&2
    exit 2
    ;;
esac
if [ "${keep_releases}" -lt 2 ]; then
  printf '%s\n' 'SUMMING_DEPLOY_KEEP_RELEASES must be at least 2.' >&2
  exit 2
fi
if [ ! -d "${repo_dir}" ] || [ ! -e "${repo_dir}/.git" ]; then
  printf 'SUMMING repository is missing from %s.\n' "${repo_dir}" >&2
  exit 2
fi
if ! id summing >/dev/null 2>&1; then
  printf '%s\n' 'The summing user is missing.' >&2
  exit 2
fi
if ! id summing-builder >/dev/null 2>&1; then
  printf '%s\n' 'The summing-builder user is missing; run deploy/activate.sh.' >&2
  exit 2
fi
if id -nG summing-builder | tr ' ' '\n' | grep -qx summing; then
  printf '%s\n' 'summing-builder must not belong to the secret-bearing summing group.' >&2
  exit 2
fi

install -d -o root -g root -m 0711 "${releases_dir}"
install -d -o root -g summing -m 1770 "${state_dir}"
install -d -o root -g summing -m 1770 "${event_dir}"
install -d -o root -g root -m 0755 "$(dirname "${lock_file}")"
exec 9>"${lock_file}"
if ! flock -n 9; then
  printf '%s\n' 'Another SUMMING deployment is already running.'
  exit 0
fi

now() {
  date -u +%Y-%m-%dT%H:%M:%S.%3NZ
}

started_at=$(now)
attempt_id="$(date -u +%Y%m%dT%H%M%S%3NZ)-$$"
target_sha=
previous_sha=
target_version=
previous_version=
previous_target=
switched=0
installed=0
staging_dir=
runner_config_temporary=
runner_config_backup_dir=
runner_configs_changed=0
phase=initializing
failure_kind=internal
failure_json=null
prior_status=
prior_remote_sha=
prior_finished_at=
manual_requested_at=
manual_retry=0
manual_action=deploy

valid_sha() {
  printf '%s' "${1:-}" | grep -Eq '^[0-9a-f]{40}$'
}

valid_version() {
  printf '%s' "${1:-}" | grep -Eq '^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$'
}

git_as_summing() {
  runuser -u summing -- env -i \
    HOME=/var/lib/summing \
    USER=summing \
    LOGNAME=summing \
    PATH=/usr/local/bin:/usr/bin:/bin \
    GIT_TERMINAL_PROMPT=0 \
    git "$@"
}

write_state() {
  local status=$1
  local message=$2
  local current_sha=${3:-}
  local remote_sha=${4:-}
  local finished_at=${5:-}
  local temporary
  temporary=$(mktemp "${state_dir}/.state.XXXXXX")
  jq -n \
    --arg attemptId "${attempt_id}" \
    --arg status "${status}" \
    --arg phase "${phase}" \
    --arg message "${message}" \
    --arg currentSha "${current_sha}" \
    --arg remoteSha "${remote_sha}" \
    --arg startedAt "${started_at}" \
    --arg finishedAt "${finished_at}" \
    --argjson failure "${failure_json}" \
    '{
      attemptId: $attemptId,
      status: $status,
      phase: $phase,
      message: $message,
      currentSha: (if $currentSha == "" then null else $currentSha end),
      remoteSha: (if $remoteSha == "" then null else $remoteSha end),
      failure: $failure,
      startedAt: $startedAt,
      finishedAt: (if $finishedAt == "" then null else $finishedAt end)
    }' > "${temporary}"
  chown root:summing "${temporary}"
  chmod 0640 "${temporary}"
  mv -f "${temporary}" "${state_file}"
}

record_attempt() {
  local previous temporary
  previous=$(mktemp "${state_dir}/.history-previous.XXXXXX")
  temporary=$(mktemp "${state_dir}/.history.XXXXXX")
  printf '[]\n' > "${previous}"
  if [ -f "${history_file}" ] && [ ! -L "${history_file}" ] && \
    [ "$(stat -c %u "${history_file}" 2>/dev/null || printf 1)" = 0 ] && \
    jq -e 'type == "array"' "${history_file}" >/dev/null 2>&1; then
    cp -- "${history_file}" "${previous}"
  fi
  if ! jq -n \
    --slurpfile current "${state_file}" \
    --slurpfile previous "${previous}" \
    --argjson limit "${history_limit}" \
    '([$current[0]] + [
      $previous[0][] | select(.attemptId != $current[0].attemptId)
    ])[:$limit]' > "${temporary}"; then
    rm -f -- "${previous}" "${temporary}"
    return 1
  fi
  chown root:summing "${temporary}"
  chmod 0640 "${temporary}"
  mv -f "${temporary}" "${history_file}"
  rm -f -- "${previous}"
}

write_deployment_event() {
  local event_kind=$1
  local message=$2
  local temporary target created_at
  temporary=$(mktemp "${event_dir}/.event.XXXXXX") || return 1
  target=${event_dir}/${attempt_id}-${event_kind}.json
  created_at=$(now)
  if ! jq -n \
    --argjson schemaVersion 1 \
    --arg eventId "${attempt_id}" \
    --arg kind "${event_kind}" \
    --arg message "${message}" \
    --arg previousVersion "${previous_version}" \
    --arg targetVersion "${target_version}" \
    --arg previousSha "${previous_sha}" \
    --arg targetSha "${target_sha}" \
    --arg createdAt "${created_at}" \
    --argjson failure "${failure_json}" \
    '{
      schemaVersion: $schemaVersion,
      eventId: $eventId,
      kind: $kind,
      message: $message,
      previousVersion: (if $previousVersion == "" then null else $previousVersion end),
      targetVersion: (if $targetVersion == "" then null else $targetVersion end),
      previousSha: (if $previousSha == "" then null else $previousSha end),
      targetSha: (if $targetSha == "" then null else $targetSha end),
      failure: $failure,
      createdAt: $createdAt
    }' > "${temporary}"; then
    rm -f -- "${temporary}"
    return 1
  fi
  if ! chown summing:summing "${temporary}" || \
    ! chmod 0600 "${temporary}" || \
    ! mv -f "${temporary}" "${target}"; then
    rm -f -- "${temporary}"
    return 1
  fi
}

set_simple_failure() {
  local kind=$1
  local code=$2
  local detail=${3:-}
  failure_json=$(jq -n \
    --arg kind "${kind}" \
    --arg phase "${phase}" \
    --argjson exitCode "${code}" \
    --arg logTail "${detail}" \
    '{kind: $kind, phase: $phase, exitCode: $exitCode, logTail: $logTail, tests: null}')
}

set_builder_failure() {
  local kind=$1
  local code=$2
  local log_file=$3
  failure_json=$("${deploy_report}" "${kind}" "${phase}" "${code}" "${log_file}")
}

deployed_sha() {
  local metadata=${current_link}/.summing-release.json
  local candidate=
  if [ -f "${metadata}" ]; then
    candidate=$(jq -r '.sha // empty' "${metadata}" 2>/dev/null || true)
  elif [ -e "${current_link}/.git" ]; then
    candidate=$(git_as_summing -C "${current_link}" rev-parse HEAD 2>/dev/null || true)
  fi
  if valid_sha "${candidate}"; then printf '%s\n' "${candidate}"; fi
}

switch_current() {
  local target=$1
  local next_link=/opt/.summing-current.$$.new
  rm -f "${next_link}"
  ln -s "${target}" "${next_link}"
  mv -Tf "${next_link}" "${current_link}"
}

sync_project_runner_configs() {
  local release=$1
  local config_dir=/etc/summing-project-runner/projects
  local asset project_id target legacy_env_path candidate
  local -a assets=()

  runner_configs_changed=0
  if ! id summing-project-runner >/dev/null 2>&1 || [ ! -d "${config_dir}" ]; then
    return 0
  fi

  shopt -s nullglob
  assets=("${release}"/deploy/*.runner.json)
  shopt -u nullglob
  for asset in "${assets[@]}"; do
    project_id=$(basename "${asset}" .runner.json)
    case "${project_id}" in
      ''|[!a-z0-9]*|*[!a-z0-9-]*)
        printf 'Invalid managed runner project id: %s\n' "${project_id}" >&2
        return 2
        ;;
    esac
    if ! jq -e '
      type == "object" and
      (
        (((.configPath? | type) == "string") and (has("configSourcePaths") | not)) or
        (((.configSourcePaths? | type) == "array") and
          (.configSourcePaths | length) > 0 and
          all(.configSourcePaths[]; type == "string") and
          (has("configPath") | not))
      )
    ' "${asset}" >/dev/null; then
      printf 'Managed runner config is invalid: %s\n' "${asset}" >&2
      return 2
    fi

    target=${config_dir}/${project_id}.json
    if [ -L "${target}" ]; then
      printf 'Managed runner config must not be a symlink: %s\n' "${target}" >&2
      return 2
    fi
    if [ -e "${target}" ] && [ ! -f "${target}" ]; then
      printf 'Managed runner config must be a regular file: %s\n' "${target}" >&2
      return 2
    fi
    legacy_env_path=
    if [ -f "${target}" ]; then
      legacy_env_path=$(jq -r '.envPath // empty' "${target}" 2>/dev/null || true)
    fi

    candidate=$(mktemp "${config_dir}/.${project_id}.XXXXXX")
    runner_config_temporary=${candidate}
    if [ -n "${legacy_env_path}" ]; then
      if ! jq --arg envPath "${legacy_env_path}" '. + {envPath: $envPath}' \
        "${asset}" > "${candidate}"; then
        rm -f -- "${candidate}"
        runner_config_temporary=
        return 2
      fi
    elif ! jq . "${asset}" > "${candidate}"; then
      rm -f -- "${candidate}"
      runner_config_temporary=
      return 2
    fi

    if [ -f "${target}" ] && cmp -s "${candidate}" "${target}"; then
      rm -f -- "${candidate}"
      runner_config_temporary=
      continue
    fi
    if [ -z "${runner_config_backup_dir}" ]; then
      runner_config_backup_dir=$(mktemp -d /run/summing-project-runner-configs.XXXXXX)
      chmod 0700 "${runner_config_backup_dir}"
    fi
    if [ ! -e "${runner_config_backup_dir}/${project_id}.json" ] && \
      [ ! -e "${runner_config_backup_dir}/${project_id}.missing" ]; then
      if [ -f "${target}" ]; then
        cp -p -- "${target}" "${runner_config_backup_dir}/${project_id}.json"
      else
        : > "${runner_config_backup_dir}/${project_id}.missing"
      fi
    fi
    chown root:summing-project-runner "${candidate}"
    chmod 0640 "${candidate}"
    mv -f -- "${candidate}" "${target}"
    runner_config_temporary=
    runner_configs_changed=1
  done
}

restore_project_runner_configs() {
  local config_dir=/etc/summing-project-runner/projects
  local backup marker project_id target
  local -a backups=() markers=()

  if [ -z "${runner_config_backup_dir}" ]; then return 0; fi
  shopt -s nullglob
  backups=("${runner_config_backup_dir}"/*.json)
  markers=("${runner_config_backup_dir}"/*.missing)
  shopt -u nullglob
  for backup in "${backups[@]}"; do
    project_id=$(basename "${backup}" .json)
    target=${config_dir}/${project_id}.json
    if [ -L "${target}" ]; then
      printf 'Refusing to restore a symlinked runner config: %s\n' "${target}" >&2
      return 2
    fi
    install -o root -g summing-project-runner -m 0640 "${backup}" "${target}"
  done
  for marker in "${markers[@]}"; do
    project_id=$(basename "${marker}" .missing)
    target=${config_dir}/${project_id}.json
    if [ -L "${target}" ]; then
      printf 'Refusing to remove a symlinked runner config: %s\n' "${target}" >&2
      return 2
    fi
    rm -f -- "${target}"
  done
  rm -f -- "${backups[@]}" "${markers[@]}"
  rmdir "${runner_config_backup_dir}"
  runner_config_backup_dir=
}

discard_project_runner_config_backup() {
  local -a backup_files=()
  if [ -z "${runner_config_backup_dir}" ]; then return 0; fi
  shopt -s nullglob
  backup_files=("${runner_config_backup_dir}"/*)
  shopt -u nullglob
  if [ "${#backup_files[@]}" -gt 0 ]; then rm -f -- "${backup_files[@]}"; fi
  rmdir "${runner_config_backup_dir}"
  runner_config_backup_dir=
}

finalize_project_environment_cutover() {
  local release=$1
  local hook=${release}/deploy/project-environment-cutover
  if [ ! -x "${hook}" ]; then return 0; fi
  SUMMING_ENV_MIGRATION_RELEASE="${release}" "${hook}"
}

sync_systemd_units() {
  local release=$1
  local hook=${release}/deploy/sync-systemd-units
  if [ ! -x "${hook}" ]; then return 0; fi
  SUMMING_SYSTEMD_RELEASE="${release}" "${hook}"
}

install_project_runner_host() {
  local release=$1
  local installer=${release}/deploy/install-project-runner-host
  if [ ! -x "${installer}" ] || [ -L "${installer}" ]; then
    printf 'SUMMING project runner installer is missing or unsafe: %s\n' "${installer}" >&2
    return 2
  fi
  SUMMING_PROJECT_RUNNER_RELEASE="${release}" \
    SUMMING_PROJECT_RUNNER_INSTALL_STATIC_CONFIGS=0 \
    "${installer}"
}

restart_services() {
  if systemctl is-enabled --quiet summing-project-runner.service 2>/dev/null; then
    systemctl restart summing-project-runner.service
  fi
  systemctl restart summing.service
}

wait_for_health() {
  local runner_required=0
  if systemctl is-enabled --quiet summing-project-runner.service 2>/dev/null; then
    runner_required=1
  fi
  for _ in $(seq 1 60); do
    if curl --fail --silent http://127.0.0.1:8765/health >/dev/null 2>&1; then
      if [ "${runner_required}" = 0 ] || \
        curl --fail --silent --unix-socket /run/summing-project-runner/runner.sock \
          http://localhost/health >/dev/null 2>&1; then
        return 0
      fi
    fi
    sleep 1
  done
  return 1
}

wait_for_idle_runtime() {
  local deadline=$((SECONDS + drain_timeout))
  local payload=
  local active=0
  while payload=$(curl --fail --silent http://127.0.0.1:8765/health 2>/dev/null); do
    active=$(printf '%s' "${payload}" | jq -r '.active // 0' 2>/dev/null || printf '0')
    if [ "${active}" = 0 ]; then return 0; fi
    if [ "${SECONDS}" -ge "${deadline}" ]; then
      printf 'Timed out waiting for %s active run(s) to finish.\n' "${active}" >&2
      return 1
    fi
    write_state \
      waiting \
      "Ждём завершения активных runs: ${active}" \
      "${previous_sha}" \
      "${target_sha}"
    sleep 5
  done
}

fail_deployment() {
  local code=$1
  local message=$2
  local failure_current_sha=${previous_sha}
  local restore_runner_configs=0
  trap - ERR
  set +e
  if [ -n "${staging_dir}" ] && [ -d "${staging_dir}" ]; then
    rm -rf -- "${staging_dir}"
    staging_dir=
  fi
  if [ -n "${runner_config_temporary}" ]; then
    rm -f -- "${runner_config_temporary}"
    runner_config_temporary=
  fi
  if { [ "${switched}" = 1 ] && [ -n "${previous_target}" ]; } || \
    [ -n "${runner_config_backup_dir}" ]; then
    write_state rolling_back "${message}; возвращаем предыдущий release" "${target_sha}" "${target_sha}"
  fi
  if [ "${switched}" = 1 ] && [ -n "${previous_target}" ]; then
    switch_current "${previous_target}"
  fi
  if [ -n "${runner_config_backup_dir}" ]; then
    restore_runner_configs=1
    if ! restore_project_runner_configs; then
      printf '%s\n' 'Could not restore managed runner configs during rollback.' >&2
    fi
  fi
  if [ "${switched}" = 1 ] && [ -n "${previous_target}" ]; then
    restart_services
    wait_for_health
    switched=0
    installed=0
  elif [ "${restore_runner_configs}" = 1 ] && \
    systemctl is-enabled --quiet summing-project-runner.service 2>/dev/null; then
    systemctl restart summing-project-runner.service
    wait_for_health
  fi
  if [ "${installed}" = 1 ]; then failure_current_sha=${target_sha}; fi
  write_state failed "${message}" "${failure_current_sha}" "${target_sha}" "$(now)"
  record_attempt || printf '%s\n' 'Could not persist deployment attempt history.' >&2
  case "$(printf '%s' "${failure_json}" | jq -r '.kind // empty' 2>/dev/null)" in
    lint|tests)
      write_deployment_event update_failed "${message}" || \
        printf '%s\n' 'Could not persist deployment failure event.' >&2
      ;;
  esac
  printf '%s\n' "${message}" >&2
  exit "${code}"
}

on_error() {
  local line=$1
  local code=$2
  local message="Ошибка на этапе ${phase}, строка ${line} (exit ${code})"
  if [ "${failure_json}" = null ]; then
    set_simple_failure "${failure_kind}" "${code}" "${message}"
  fi
  fail_deployment "${code}" "${message}"
}

run_builder_phase() {
  local kind=$1
  local next_phase=$2
  local message=$3
  shift 3
  local log_file command_status failed_count total_count failure_message
  local -a pipeline_status
  phase=${next_phase}
  failure_kind=${kind}
  write_state building "${message}" "${previous_sha}" "${target_sha}"
  log_file=$(mktemp "${state_dir}/.builder-log.XXXXXX")
  if runuser -u summing-builder -- env -i \
    HOME=/var/lib/summing-builder \
    USER=summing-builder \
    LOGNAME=summing-builder \
    PATH=/usr/local/bin:/usr/bin:/bin \
    CI=1 \
    bash -c 'cd "$1" && shift && exec "$@"' _ "${staging_dir}" "$@" \
    2>&1 | tee "${log_file}"; then
    command_status=0
  else
    pipeline_status=("${PIPESTATUS[@]}")
    command_status=${pipeline_status[0]}
    if [ "${command_status}" = 0 ]; then command_status=${pipeline_status[1]}; fi
  fi
  if [ "${command_status}" = 0 ]; then
    rm -f -- "${log_file}"
    return 0
  fi
  set_builder_failure "${kind}" "${command_status}" "${log_file}"
  rm -f -- "${log_file}"
  failed_count=$(printf '%s' "${failure_json}" | jq -r '.tests.failed // empty')
  total_count=$(printf '%s' "${failure_json}" | jq -r '.tests.total // empty')
  if [ "${kind}" = tests ] && [ -n "${failed_count}" ]; then
    failure_message="Тесты не пройдены: ${failed_count}${total_count:+ из ${total_count}}"
  else
    failure_message="Этап ${next_phase} завершился ошибкой (exit ${command_status})"
  fi
  fail_deployment "${command_status}" "${failure_message}"
}
trap 'error_code=$?; on_error ${LINENO} "${error_code}"' ERR

previous_target=$(readlink -f "${current_link}" 2>/dev/null || true)
previous_sha=$(deployed_sha || true)
if [ -z "${previous_target}" ] || [ ! -d "${previous_target}" ]; then
  set_simple_failure runtime 2 'Current release symlink is missing; run deploy/activate.sh first.'
  fail_deployment 2 'Текущий release symlink отсутствует; запустите deploy/activate.sh'
fi
previous_version=$(jq -r '.version // empty' "${previous_target}/package.json" 2>/dev/null || true)
if ! valid_version "${previous_version}"; then previous_version=; fi
if [ -f "${state_file}" ]; then
  prior_status=$(jq -r '.status // empty' "${state_file}" 2>/dev/null || true)
  prior_remote_sha=$(jq -r '.remoteSha // empty' "${state_file}" 2>/dev/null || true)
  prior_finished_at=$(jq -r '.finishedAt // empty' "${state_file}" 2>/dev/null || true)
fi
if [ -f "${state_dir}/request.json" ]; then
  manual_requested_at=$(jq -r '.requestedAt // empty' \
    "${state_dir}/request.json" 2>/dev/null || true)
fi
if [ -n "${manual_requested_at}" ] && \
  { [ -z "${prior_finished_at}" ] || [[ "${manual_requested_at}" > "${prior_finished_at}" ]]; }; then
  manual_retry=1
  manual_action=$(jq -r \
    'if .action == "check" then "check" else "deploy" end' \
    "${state_dir}/request.json" 2>/dev/null || printf '%s' deploy)
fi
phase=source-verification
failure_kind=source
write_state checking "Проверяем источник ${remote}/${branch}" "${previous_sha}" ""

actual_remote=$(git_as_summing -C "${repo_dir}" remote get-url "${remote}")
if [ -n "${expected_remote}" ] && [ "${actual_remote}" != "${expected_remote}" ]; then
  set_simple_failure source 1 \
    "Ожидался ${expected_remote}; настроен ${actual_remote}"
  fail_deployment 1 "Источник ${remote} не одобрен политикой deployment"
fi
phase=fetch
failure_kind=fetch
write_state checking "Получаем ${remote}/${branch}" "${previous_sha}" ""
git_as_summing -C "${repo_dir}" fetch --prune "${remote}" \
  "+refs/heads/${branch}:refs/remotes/${remote}/${branch}"

phase=resolve
target_sha=$(git_as_summing -C "${repo_dir}" rev-parse \
  "refs/remotes/${remote}/${branch}^{commit}")
if ! valid_sha "${target_sha}"; then
  set_simple_failure source 1 'Remote branch did not resolve to a full commit SHA.'
  fail_deployment 1 'Remote branch не разрешился в полный commit SHA'
fi
target_version=$(git_as_summing -C "${repo_dir}" show \
  "${target_sha}:package.json" 2>/dev/null | jq -r '.version // empty' 2>/dev/null || true)
if ! valid_version "${target_version}"; then target_version=; fi
if [ "${manual_action}" = check ]; then
  phase=complete
  if [ "${previous_sha}" = "${target_sha}" ]; then
    origin_message="Origin проверен: установлена актуальная версия"
  else
    origin_message="Origin проверен: доступна новая версия"
  fi
  write_state idle "${origin_message}" "${previous_sha}" "${target_sha}" "$(now)"
  exit 0
fi
if [ "${previous_sha}" = "${target_sha}" ]; then
  phase=runner-host
  failure_kind=runtime
  install_project_runner_host "${previous_target}"
  phase=sync
  failure_kind=runtime
  sync_project_runner_configs "${previous_target}"
  if [ "${runner_configs_changed}" = 1 ] && \
    systemctl is-enabled --quiet summing-project-runner.service 2>/dev/null; then
    write_state deploying "Обновляем конфигурацию Project runner" \
      "${previous_sha}" "${target_sha}"
    systemctl restart summing-project-runner.service
    wait_for_health
  fi
  phase=systemd-sync
  failure_kind=runtime
  sync_systemd_units "${previous_target}"
  phase=cutover
  failure_kind=cutover
  cutover_status=0
  finalize_project_environment_cutover "${previous_target}" || cutover_status=$?
  if [ "${cutover_status}" = 75 ]; then
    write_state waiting \
      "Версия установлена; ждём Validate/Dry run для migration cutover" \
      "${previous_sha}" "${target_sha}" "$(now)"
    record_attempt || printf '%s\n' 'Could not persist deployment attempt history.' >&2
    discard_project_runner_config_backup
    exit 0
  fi
  if [ "${cutover_status}" != 0 ]; then
    set_simple_failure cutover "${cutover_status}" \
      'Installed release migration cutover failed.'
    fail_deployment "${cutover_status}" \
      'Версия установлена, но завершение migration cutover не удалось'
  fi
  phase=complete
  if [ "${prior_status}" = waiting ] && [ "${prior_remote_sha}" = "${target_sha}" ]; then
    write_state succeeded "Обновление установлено" "${target_sha}" "${target_sha}" \
      "$(now)"
    record_attempt || printf '%s\n' 'Could not persist deployment attempt history.' >&2
    write_deployment_event update_succeeded 'Обновление установлено' || \
      printf '%s\n' 'Could not persist deployment success event.' >&2
  else
    write_state idle "Установлена актуальная версия" "${previous_sha}" "${target_sha}" \
      "$(now)"
  fi
  discard_project_runner_config_backup
  exit 0
fi
if [ "${prior_status}" = failed ] && \
  [ "${prior_remote_sha}" = "${target_sha}" ] && \
  [ "${manual_retry}" = 0 ]; then
  phase=blocked
  write_state failed \
    "Предыдущая попытка не удалась; ждём новый commit или ручной повтор" \
    "${previous_sha}" \
    "${target_sha}" \
    "$(now)"
  exit 0
fi
if valid_sha "${previous_sha}" && \
  git_as_summing -C "${repo_dir}" cat-file -e "${previous_sha}^{commit}" 2>/dev/null && \
  ! git_as_summing -C "${repo_dir}" merge-base --is-ancestor \
    "${previous_sha}" "${target_sha}"; then
  phase=source-verification
  set_simple_failure source 1 \
    "Non-fast-forward: ${previous_sha} -> ${target_sha}"
  fail_deployment 1 'Deployment отклонён: origin/master не является fast-forward'
fi

release_dir=${releases_dir}/${target_sha}
if [ ! -f "${release_dir}/.summing-release.json" ]; then
  staging_dir=${releases_dir}/.${target_sha}.tmp.$$
  install -d -o summing-builder -g summing-builder -m 0700 "${staging_dir}"
  phase=archive
  failure_kind=archive
  write_state building "Экспортируем ${target_sha:0:12}" "${previous_sha}" "${target_sha}"
  git_as_summing -C "${repo_dir}" archive "${target_sha}" | \
    runuser -u summing-builder -- tar -x -C "${staging_dir}"
  run_builder_phase dependencies dependencies \
    "Устанавливаем зависимости ${target_sha:0:12}" \
    npm ci --no-audit --no-fund
  run_builder_phase lint lint \
    "Проверяем типы и lint ${target_sha:0:12}" \
    npm run lint
  run_builder_phase tests test \
    "Запускаем тесты ${target_sha:0:12}" \
    npm test
  run_builder_phase prune prune \
    "Оставляем production dependencies ${target_sha:0:12}" \
    npm prune --omit=dev --no-audit --no-fund
  jq -n \
    --arg sha "${target_sha}" \
    --arg createdAt "$(now)" \
    '{sha: $sha, createdAt: $createdAt}' > "${staging_dir}/.summing-release.json"
  chown -R root:summing "${staging_dir}"
  chmod -R u=rwX,g=rX,o= "${staging_dir}"
  chmod 0644 "${staging_dir}/.summing-release.json"
  mv "${staging_dir}" "${release_dir}"
  staging_dir=
fi

phase=drain
failure_kind=runtime
wait_for_idle_runtime
phase=restart
failure_kind=restart
write_state deploying "Перезапускаем сервисы на ${target_sha:0:12}" "${previous_sha}" "${target_sha}"
switch_current "${release_dir}"
switched=1
phase=runner-host
failure_kind=runtime
install_project_runner_host "${release_dir}"
phase=sync
failure_kind=runtime
sync_project_runner_configs "${release_dir}"
phase=restart
restart_services
phase=health
failure_kind=health
write_state deploying "Проверяем health ${target_sha:0:12}" "${previous_sha}" "${target_sha}"
wait_for_health
phase=systemd-sync
failure_kind=runtime
sync_systemd_units "${release_dir}"
switched=0
installed=1

phase=cutover
failure_kind=cutover
cutover_status=0
finalize_project_environment_cutover "${release_dir}" || cutover_status=$?
if [ "${cutover_status}" = 75 ]; then
  write_state waiting \
    "Версия установлена; ждём Validate/Dry run для migration cutover" \
    "${target_sha}" "${target_sha}" "$(now)"
  record_attempt || printf '%s\n' 'Could not persist deployment attempt history.' >&2
  discard_project_runner_config_backup
  exit 0
fi
if [ "${cutover_status}" != 0 ]; then
  set_simple_failure cutover "${cutover_status}" \
    'Installed release migration cutover failed.'
  fail_deployment "${cutover_status}" \
    'Версия установлена, но завершение migration cutover не удалось'
fi

phase=complete
write_state succeeded "Обновление установлено" "${target_sha}" "${target_sha}" \
  "$(now)"
record_attempt || printf '%s\n' 'Could not persist deployment attempt history.' >&2
write_deployment_event update_succeeded 'Обновление установлено' || \
  printf '%s\n' 'Could not persist deployment success event.' >&2
discard_project_runner_config_backup

current_target=$(readlink -f "${current_link}")
if ! find "${releases_dir}" -mindepth 1 -maxdepth 1 -type d \
  -name '[0-9a-f][0-9a-f]*' -printf '%T@ %p\n' | \
  sort -rn | tail -n "+$((keep_releases + 1))" | cut -d' ' -f2- | \
  while IFS= read -r old_release; do
    if [ -n "${old_release}" ] && [ "${old_release}" != "${current_target}" ]; then
      rm -rf -- "${old_release}"
    fi
  done; then
  printf '%s\n' 'Deployment succeeded, but pruning old releases failed.' >&2
fi

printf 'SUMMING deployed at %s.\n' "${target_sha}"
