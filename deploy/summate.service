[Unit]
Description=Summate Telegram agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=summate
Group=summate
WorkingDirectory=/opt/summate
Environment=HOME=/var/lib/summate
EnvironmentFile=/etc/summate/summate.env
ExecStart=/usr/local/bin/node --enable-source-maps /opt/summate/dist/src/index.js
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 99
KillMode=control-group
TimeoutStopSec=20
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
