SUMMATE_DATA_DIR=/var/lib/summate/data
SUMMATE_CONFIG=/var/lib/summate/data/config.toml
SUMMATE_WORKTREE_ROOT=/var/lib/summate/data/worktrees
CODEX_HOME=/var/lib/summate/data/codex
CODEX_BIN=/usr/local/bin/codex
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
SUMMATE_VIEWER_URL=
SUMMATE_VIEWER_LOCAL_TOKEN=
SUMMATE_RUNNER_SOCKET=/run/summate-runner/runner.sock
SUMMATE_DEPLOY_REQUEST=/var/lib/summate/deploy/request.json
SUMMATE_DEPLOY_STATE=/var/lib/summate/deploy/state.json
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_API_KEY=
GROQ_API_KEY=
NODE_ENV=production
